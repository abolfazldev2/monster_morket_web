# Copy to .env and replace both values before starting the project.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=monster_market
POSTGRES_USER=monster_market
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173
TELEGRAM_SUPPORT_USERNAME=abolfazls-s
FRONTEND_URL=http://localhost
# Steam OpenID rejects localhost. For Steam login tests, use a public HTTPS tunnel
# and put its hostname in both URLs; for production use your own HTTPS domain.
STEAM_OPENID_RETURN_URL=http://localhost/api/users/steam/callback/
